# OpenAI API key for image generation (REQUIRED for live runs)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenAI Admin/Org key for usage reconcile (OPTIONAL — Phase 5)
# Different from above; needs org admin scope
OPENAI_ADMIN_KEY=

# Storage paths (relative to project root)
DATABASE_URL=sqlite:///data/app.db
OUTPUT_DIR=outputs
UPLOAD_DIR=data/uploads

# Worker
DEFAULT_CONCURRENCY=5

# Image processing
MAX_REF_DIMENSION=2048

# Server
HOST=127.0.0.1
PORT=8000
