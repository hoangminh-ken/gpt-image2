{
  "name": "gpt-image2",
  "version": "0.6.0",
  "private": true,
  "description": "GPT-Image-2 batch image generator (FastAPI + React local web app)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-backend.cjs uvicorn app.main:app --reload --host 127.0.0.1 --port 8765",
    "dev:web": "cd frontend && npm run dev",
    "test:api": "node scripts/run-backend.cjs pytest tests/",
    "build:web": "cd frontend && npm run build",
    "install:all": "node scripts/install-all.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
